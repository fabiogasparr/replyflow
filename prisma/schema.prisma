// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String       @id @default(cuid())
  name              String?
  email             String?      @unique
  emailVerified     DateTime?
  image             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  activeWorkspaceId String?
  platformRole      PlatformRole @default(USER)

  accounts         Account[]
  sessions         Session[]
  ownedWorkspaces  Workspace[]           @relation("WorkspaceOwner")
  activeWorkspace  Workspace?            @relation("UserActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
  workspaceMembers WorkspaceMember[]
  sentInvitations  WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
  auditEvents      AuditEvent[]          @relation("AuditActor")

  @@index([activeWorkspaceId])
  @@index([platformRole])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id         String        @id @default(cuid())
  name       String
  ownerId    String
  owner      User          @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  archivedAt DateTime?
  plan       WorkspacePlan @default(FREE)

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  members           WorkspaceMember[]
  activeUsers       User[]                @relation("UserActiveWorkspace")
  invitations       WorkspaceInvitation[]
  instagramAccounts InstagramAccount[]
  automations       Automation[]
  dmLogs            DmLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  auditEvents       AuditEvent[]
  contacts          Contact[]
  conversations     Conversation[]
  subscription      Subscription?
  usageRecords      UsageRecord[]
  billingEvents     BillingEvent[]

  @@index([ownerId])
  @@index([archivedAt])
}

model Plan {
  code              WorkspacePlan @id
  name              String
  currency          String        @default("BRL")
  monthlyPriceCents Int?
  monthlyDmLimit    Int
  instagramAccounts Int
  members           Int
  isActive          Boolean       @default(true)
  sortOrder         Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  subscriptions Subscription[]

  @@index([isActive, sortOrder])
}

model Subscription {
  id                     String             @id @default(cuid())
  workspaceId            String             @unique
  planCode               WorkspacePlan      @default(FREE)
  provider               BillingProvider    @default(MANUAL)
  status                 SubscriptionStatus @default(ACTIVE)
  providerCustomerId     String?
  providerSubscriptionId String?
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  lastProviderEventAt    DateTime?
  lastProviderEventId    String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan          Plan           @relation(fields: [planCode], references: [code], onDelete: Restrict)
  billingEvents BillingEvent[]

  @@unique([id, workspaceId])
  @@unique([provider, providerCustomerId])
  @@unique([provider, providerSubscriptionId])
  @@index([planCode, status])
  @@index([provider, status])
  @@index([provider, lastProviderEventAt])
}

model UsageRecord {
  id          String      @id @default(cuid())
  workspaceId String
  metric      UsageMetric
  periodStart DateTime
  periodEnd   DateTime
  quantity    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, metric, periodStart])
  @@index([workspaceId, periodStart, periodEnd])
}

model BillingEvent {
  id              String             @id @default(cuid())
  workspaceId     String
  subscriptionId  String?
  provider        BillingProvider
  providerEventId String
  type            String
  status          BillingEventStatus @default(PENDING)
  occurredAt      DateTime
  processedAt     DateTime?
  failureReason   String?
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace             Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[] @relation("ConversationAssignee")

  @@unique([workspaceId, userId])
  @@unique([id, workspaceId])
  @@index([userId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

model InstagramAccount {
  id                String    @id @default(cuid())
  workspaceId       String
  instagramId       String    @unique
  username          String
  name              String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean   @default(false)
  connectedAt       DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations       Automation[]
  dmLogs            DmLog[]
  linkClicks        LinkClick[]
  followerSnapshots FollowerSnapshot[]
  contacts          Contact[]
  conversations     Conversation[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([tokenExpiresAt])
}

/// A person observed in automation logs, scoped to one workspace and account.
/// Derived identity/name/dates are synchronized by the DmLog database trigger.
model Contact {
  id                 String    @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  instagramScopedId  String
  username           String?
  usernameObservedAt DateTime?
  tags               String[]  @default([])
  notes              String?
  /// Optimistic concurrency token changed only by manual edits.
  version            Int       @default(0)
  firstSeenAt        DateTime
  lastSeenAt         DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  conversations    Conversation[]

  @@unique([workspaceId, instagramAccountId, instagramScopedId], map: "Contact_workspace_account_scoped_key")
  @@unique([id, workspaceId, instagramAccountId])
  @@index([workspaceId, lastSeenAt])
  @@index([workspaceId, instagramAccountId, lastSeenAt])
}

/// Team-owned state layered over a conversation fetched from Meta's official API.
/// Message bodies remain at Meta; only operational metadata and the latest preview
/// are stored locally.
model Conversation {
  id                 String               @id @default(cuid())
  workspaceId        String
  instagramAccountId String
  contactId          String
  metaConversationId String
  status             ConversationStatus   @default(OPEN)
  priority           ConversationPriority @default(NORMAL)
  assignedMemberId   String?
  notes              String?
  version            Int                  @default(0)
  lastMessageText    String?
  lastMessageAt      DateTime?
  lastMessageFromMe  Boolean?
  lastInboundAt      DateTime?
  lastSyncedAt       DateTime             @default(now())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  contact          Contact          @relation(fields: [contactId, workspaceId, instagramAccountId], references: [id, workspaceId, instagramAccountId], onDelete: Cascade)
  assignedMember   WorkspaceMember? @relation("ConversationAssignee", fields: [assignedMemberId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([workspaceId, instagramAccountId, metaConversationId])
  @@index([workspaceId, status, priority, lastMessageAt])
  @@index([assignedMemberId])
  @@index([contactId])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  instagramAccountId String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId, date])
}

model Automation {
  id                 String @id @default(cuid())
  workspaceId        String
  instagramAccountId String

  name                    String
  goal                    String?
  postId                  String?
  postUrl                 String?
  pendingNextReel         Boolean  @default(false)
  matchAnyPost            Boolean  @default(false)
  keywords                String[]
  matchAnyWord            Boolean  @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger — a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled        Boolean  @default(false)
  dmMessage               String
  openingDmEnabled        Boolean  @default(false)
  openingDmMessage        String?
  openingDmButtonLabel    String?
  linkButtonLabel         String?
  requireFollow           Boolean  @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled         Boolean  @default(false)
  followUpMessage         String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes    Int      @default(0)
  publicReplyEnabled      Boolean  @default(false)
  publicReplyMessage      String?
  publicReplyMessages     String[] @default([])
  isActive                Boolean  @default(true)
  wholeWordMatch          Boolean  @default(true)
  reportShareSlug         String?  @unique
  reportShareEnabled      Boolean  @default(true)

  // Operational projection maintained by the worker. It is intentionally
  // separate from isActive: an enabled campaign can still need attention when
  // its credentials or most recent platform execution failed.
  lastRunAt           DateTime?
  lastSuccessAt       DateTime?
  lastErrorAt         DateTime?
  lastErrorKind       String?
  lastErrorMessage    String?
  consecutiveFailures Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  dmLogs           DmLog[]
  trackedLinks     TrackedLink[]
  linkClicks       LinkClick[]

  @@index([workspaceId])
  @@index([instagramAccountId])
  @@index([postId])
  @@index([workspaceId, lastErrorAt])
  @@index([lastErrorAt])
}

model DmLog {
  id                 String @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String

  commenterId    String
  commenterName  String?
  commentText    String
  commentId      String
  matchedKeyword String?
  status         DmStatus  @default(PENDING)
  attempts       Int       @default(0)
  dmSentAt       DateTime?
  errorMessage   String?

  // Replay metadata is persisted with the log so an operator never has to
  // reconstruct a queue job from mutable campaign state. deliveryAttemptedAt
  // is the safety boundary: a FAILED row after this timestamp is intentionally
  // not eligible for manual retry because Meta may have accepted the message
  // even if the response was lost.
  triggerType         DmTriggerType @default(COMMENT)
  sourceEventId       String?
  sourceMediaId       String?
  originalMediaId     String?
  source              String?
  deliveryAttemptedAt DateTime?
  manualRetryCount    Int           @default(0)
  lastManualRetryAt   DateTime?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId, instagramAccountId, commenterId, createdAt], map: "DmLog_contact_createdAt_idx")
  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([status])
  @@index([updatedAt])
}

// Every comment the system has seen, from either the webhook or the polling
// reconciler. This is the shared dedup set: a comment id present here has
// already been queued for processing, so neither path acts on it twice. It is
// distinct from DmLog (which only records comments that matched a campaign);
// this records all comments so the reconciler doesn't re-sweep non-matching
// ones every cycle.
model ProcessedComment {
  id                 String   @id @default(cuid())
  instagramAccountId String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([instagramAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  instagramAccountId String
  trackedLinkId      String
  ipHash             String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation       Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)
  instagramAccount InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  trackedLink      TrackedLink      @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([instagramAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id           String        @id @default(cuid())
  workspaceId  String?
  object       String?
  payload      Json
  status       WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt    DateTime      @default(now())
  processedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}

model OperationalEvent {
  id          String                 @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel  @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime               @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorUserId])
  @@index([action])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum PlatformRole {
  USER
  ADMIN
}

enum WorkspacePlan {
  FREE
  PRO
  AGENCY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum BillingProvider {
  MANUAL
  MERCADO_PAGO
  STRIPE
}

enum BillingEventStatus {
  PENDING
  PROCESSED
  FAILED
  IGNORED
}

enum UsageMetric {
  DM_SENT
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum ConversationPriority {
  NORMAL
  HIGH
}

enum DmStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum DmTriggerType {
  COMMENT
  MESSAGE
  POSTBACK
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}
