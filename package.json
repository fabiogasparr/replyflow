{
  "name": "replyflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:poll": "WATCHPACK_POLLING=true next dev",
    "build": "prisma generate && next build --webpack",
    "vercel-build": "prisma generate && prisma migrate deploy && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "worker": "tsx worker/dm-worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:contacts-db": "tsx scripts/test-contacts-db.ts",
    "test:conversations-db": "tsx scripts/test-conversations-db.ts",
    "test:dm-retry-db": "tsx scripts/test-dm-retry-db.ts",
    "test:dm-retry-queue": "tsx scripts/test-dm-retry-queue.ts",
    "test:automation-state-db": "tsx scripts/test-automation-state-db.ts",
    "test:billing-db": "tsx scripts/test-billing-db.ts",
    "test:billing-usage-db": "tsx scripts/test-billing-usage-db.ts",
    "test:platform-admin-db": "tsx scripts/test-platform-admin-db.ts",
    "test:platform-observability-db": "tsx scripts/test-platform-observability-db.ts",
    "test:performance-reporting-db": "tsx scripts/test-performance-reporting-db.ts",
    "test:report-sharing-db": "tsx scripts/test-report-sharing-db.ts",
    "admin:role": "tsx scripts/set-platform-admin.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/analytics": "^2.0.1",
    "bullmq": "^5.76.4",
    "dotenv": "^17.4.2",
    "ioredis": "^5.10.1",
    "next": "^16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "pg": "^8.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.1",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
